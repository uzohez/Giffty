# ── Frontend (Vite) ────────────────────────────────────────────────────────────
# Your LiveKit Cloud WebSocket URL  (e.g. wss://my-project-abc123.livekit.cloud)
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# URL of your token server (Railway URL in production, localhost for dev)
VITE_TOKEN_SERVER=http://localhost:3001

# ── Token server (Railway) ─────────────────────────────────────────────────────
LK_API_KEY=your_livekit_api_key
LK_API_SECRET=your_livekit_api_secret
PORT=3001
